<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background, 108x108dp: a plain vertical gradient #0094FF -> #0087FF. These are the top and bottom
     colours iOS 27 draws for the iPhone icon from its Icon Composer fill (automatic gradient of #0088FF, system blue),
     measured on the simulator home screen, so both phones show the same blue. No light spot, no second layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#FF0094FF"
                android:endColor="#FF0087FF" />
        </aapt:attr>
    </path>
</vector>
